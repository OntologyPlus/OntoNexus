# JWT Configuration
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:5173

# LLM Configuration
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

MEMORY_VECTOR_DIM=768

# Skill 学习：接受/审批后延迟评估小时数（到期按销售信号打分，不在审批当下写 0.8）
SKILL_EVALUATE_AFTER_HOURS=24

# --- Demo / Agent war room ---------------------------------------------------
# OpenAI-compatible endpoint. LLM_API_URL may be the base URL or end with /chat/completions.
# LLM_MODEL drives streaming reasoning; LLM_FAST_MODEL (optional) drives planning/reflection
# (pick a low-latency model for the stage; falls back to LLM_MODEL).
LLM_FAST_MODEL=
LLM_AGENT_TEMPERATURE=0.3
LLM_FAST_TEMPERATURE=0.1
# Hard per-request timeout and bounded retries so a slow network degrades instead of hanging.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Use "demo" locally; scripts/reset_demo.py refuses to run in any other environment.
ENV=demo
# For a live "see the effect" moment, shorten the 24h review window (hours; 0.02 ≈ 1 minute).
# SKILL_EVALUATE_AFTER_HOURS=0.02
